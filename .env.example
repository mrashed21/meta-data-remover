# =========================================================================
# mrashed21 Media Processor — Environment Variables
#
# Copy this file to .env.local and fill in values for local development.
# .env.local is git-ignored and will never be committed.
#
# NEXT_PUBLIC_* variables are exposed to the browser.
# Non-prefixed variables are server-only.
# =========================================================================

# ─── App identity (Sprint 07 SEO) ────────────────────────────────────────────

# Public URL of the deployed site (no trailing slash)
# Used for: Open Graph meta tags, canonical URLs, sitemap
NEXT_PUBLIC_SITE_URL=https://mrashed21.vercel.app

# App display name (shown in navbar, page titles, OG meta)
NEXT_PUBLIC_APP_NAME=mrashed21 Media Processor

# ─── Developer identity (Sprint 10 branding) ─────────────────────────────────

# Branding creator name injected into metadata in Mode B
# Default: "Muhammad Rashed" — override only for custom deployments
NEXT_PUBLIC_CREATOR_NAME=Muhammad Rashed

# Branding software name injected in Mode B
# Default: "mrashed21 Media Processor"
NEXT_PUBLIC_SOFTWARE_NAME=mrashed21 Media Processor

# ─── Links ───────────────────────────────────────────────────────────────────

# GitHub repository URL shown in the navbar
NEXT_PUBLIC_GITHUB_URL=https://github.com/mrashed21/meta-data-remover

# ─── Server processing (optional tuning) ─────────────────────────────────────

# Maximum concurrent sharp operations (server-side image processing)
# Default: unset (sharp auto-detects based on CPU cores)
# SHARP_CONCURRENCY=2

# Maximum upload file size in bytes (server-side guard in API route)
# Default: 52428800 (50 MB). Must match MAX_FILE_SIZE in media-types.ts.
# MAX_UPLOAD_BYTES=52428800
